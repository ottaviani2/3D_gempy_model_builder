  <widget class="QCheckBox" name="plot_checkbox">
   <property name="geometry">
    <rect>
     <x>210</x>
     <y>283</y>
     <width>131</width>
     <height>21</height>
    </rect>
   </property>
   <property name="text">
    <string>Cut with Topography</string>
   </property>
   <property name="toolTip">
    <string>The topography is built and exported (Topography.stl) whenever a DTM layer is loaded, in the source CRS. This checkbox only controls whether the structural surfaces are clipped at the topography: checked = surfaces cut at the terrain; unchecked = full, un-clipped surfaces. Either way the topography and surfaces share the same coordinate frame, so a single run produces aligned meshes.</string>
   </property>
  </widget>
