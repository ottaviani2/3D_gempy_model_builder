  <!-- AOI polygon row -->
  <widget class="QLabel" name="label_aoi">
   <property name="geometry">
    <rect>
     <x>20</x>
     <y>120</y>
     <width>75</width>
     <height>20</height>
    </rect>
   </property>
   <property name="text">
    <string>AOI Polygon</string>
   </property>
   <property name="toolTip">
    <string>Area of Interest polygon shapefile. When set, the DTM and all point layers are clipped to this polygon before processing.</string>
   </property>
  </widget>
  <widget class="QgsMapLayerComboBox" name="AOIComboBox">
   <property name="geometry">
    <rect>
     <x>100</x>
     <y>117</y>
     <width>250</width>
     <height>20</height>
    </rect>
   </property>
   <property name="toolTip">
    <string>Select a polygon vector layer to define the area of interest. Leave empty to process all data.</string>
   </property>
  </widget>
  <widget class="QPushButton" name="btnConfigureGroups">
   <property name="geometry">
    <rect>
     <x>20</x>
     <y>150</y>
     <width>180</width>
     <height>25</height>
    </rect>
   </property>
   <property name="text">
    <string>Configure Structural Groups...</string>
